# ========================================
# WA Sender — Environment Config
# Pub/Sub → WhatsApp (Evolution API)
# ========================================

# Evolution API
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE=nama-instance-kamu

# Database (SQLite, file lokal) — dipakai untuk dedup notifikasi + log outbound
DB_PATH=./data/gateway.db

# Logging
LOG_LEVEL=info

# ── Pub/Sub (Google Cloud) ──────────────────────────────────────────────────
# Konsumsi notifikasi dari Google Cloud Pub/Sub, lalu kirim ke
# penerima lewat Evolution API. Kosongkan WHATSAPP_TOPIC untuk menonaktifkan.
#
# Nama topic Pub/Sub (mis. whatsapp-outbound). Kosong = fitur dormant.
WHATSAPP_TOPIC=
# Nama subscription (default: <topic>-wa-sender). Dibuat otomatis jika belum ada.
WHATSAPP_SUBSCRIPTION=
# GCP project id. Opsional — diinfer dari ADC / emulator jika kosong.
GCP_PROJECT_ID=
# Untuk pengembangan offline dengan Pub/Sub emulator, set:
# PUBSUB_EMULATOR_HOST=localhost:8085
